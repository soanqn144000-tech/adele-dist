@echo off
REM Adele work radar (Windows). Double-click: opens the auto-detect board in the browser.
REM Wakes Adele in the background if it is not running. ASCII only (cmd.exe).
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ok=$null; function F { foreach($p in 8471,8472,8473){ try{ $r=Invoke-WebRequest \"http://127.0.0.1:$p/api/hello\" -UseBasicParsing -TimeoutSec 2; if($r.Content -match 'adele'){ return $p } }catch{} }; return $null }; $p=F; if(-not $p){ $exe=Get-ChildItem (Join-Path $env:USERPROFILE 'Adele') -Recurse -Filter Adele.exe -ErrorAction SilentlyContinue | Select-Object -First 1; if(-not $exe){ Write-Host '  Adele not found. Run Claude Code start again.'; Read-Host; exit 1 }; Write-Host '  Starting work radar...'; Start-Process $exe.FullName '--serve' -WindowStyle Hidden; for($i=0;$i -lt 60 -and -not $p;$i++){ Start-Sleep 1; $p=F } }; if($p){ Start-Process \"http://127.0.0.1:$p/board\" } else { Write-Host '  Could not start. Take a photo of this window.'; Read-Host }"